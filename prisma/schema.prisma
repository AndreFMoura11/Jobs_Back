datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Exemplo de modelo básico para testar
model Job {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  createdAt   DateTime @default(now())
}

model Vaga {
  id          Int     @id @default(autoincrement())
  title       String
  company     String
  location    String
  type        String
  salary      String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
